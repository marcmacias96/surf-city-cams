---
/**
 * Superficie de "cámara en vivo" simulada. Con foto: la foto + velo navy
 * sólido en la base para legibilidad de badges. Sin foto: gradiente oceánico
 * + olas SVG animadas como fallback. No hay video real — es el placeholder.
 */
interface Props {
  /** Clases tailwind de gradiente: SOLO fallback mientras no hay foto */
  gradient: string;
  /** Foto del spot: primera capa, bajo badges y controles */
  image?: string;
  /** Muestra el badge EN VIVO pulsante */
  live?: boolean;
  /** Estado bloqueado: candado + CTA en lugar de la vista */
  locked?: boolean;
  /** Badge superior derecho: "GRATIS" | "PREMIUM" | texto libre */
  badge?: "GRATIS" | "PREMIUM" | string | null;
  /** Botón de play central */
  play?: boolean;
  /** Nombre del spot, para etiquetas accesibles */
  name?: string;
  class?: string;
}
const { gradient, image, live = true, locked = false, badge = null, play = false, name = "", class: className = "" } = Astro.props;
---

<div class:list={["relative overflow-hidden bg-gradient-to-br", gradient, className]}>
  {image && (
    <>
      <img src={image} alt="" class:list={["absolute inset-0 h-full w-full object-cover", locked && "blur-[3px]"]} loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-dark/45 via-transparent" aria-hidden="true"></div>
    </>
  )}
  {!locked && !image && (
    <>
      <svg class="cam-wave absolute bottom-0 left-0 w-full opacity-50" viewBox="0 0 420 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="height: 42%" aria-hidden="true" focusable="false">
        <path d="M0 50c50-20 100-20 150-4s100 24 150 6 80-26 120-20v58H0z" fill="#E9F4F9"></path>
      </svg>
      <svg class="cam-wave-slow absolute bottom-0 left-0 w-full opacity-70" viewBox="0 0 420 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="height: 22%" aria-hidden="true" focusable="false">
        <path d="M0 36c60-14 130-10 200 0s150 10 220-6v30H0z" fill="#ffffff"></path>
      </svg>
    </>
  )}

  {live && !locked && (
    <div class="absolute left-3 top-3 flex items-center gap-1.5 rounded-full bg-black/55 px-3 py-1">
      <span class="live-dot inline-block size-1.5 rounded-full bg-destructive"></span>
      <span class="font-heading text-[11px] font-bold tracking-widest text-white">EN VIVO</span>
    </div>
  )}

  {badge === "GRATIS" && (
    <div class="absolute right-3 top-3 rounded-full bg-success/95 px-2.5 py-1 font-heading text-[11px] font-bold tracking-wide text-white">GRATIS</div>
  )}
  {badge === "PREMIUM" && (
    <div class="absolute right-3 top-3 flex items-center gap-1 rounded-full bg-navy-dark/85 px-2.5 py-1">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.5 6.8L12 16.8 5.9 20.3l1.5-6.8L2.2 8.9l6.9-.6z" fill="#EFDEB1"></path></svg>
      <span class="font-heading text-[11px] font-bold tracking-wide text-sand">PREMIUM</span>
    </div>
  )}
  {badge && badge !== "GRATIS" && badge !== "PREMIUM" && (
    <div class="absolute right-3 top-3 rounded-full bg-black/55 px-3 py-1 text-xs font-medium text-white">{badge}</div>
  )}

  {locked && (
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2.5 bg-navy-dark/60">
      <div class="flex size-11 items-center justify-center rounded-full bg-white">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="9" rx="2" stroke="#005279" stroke-width="2"></rect><path d="M8 11V8a4 4 0 1 1 8 0v3" stroke="#005279" stroke-width="2"></path></svg>
      </div>
      <p class="font-heading text-sm font-bold text-white">Desbloquear con un pase</p>
      <a href="/comprar" aria-label={name ? `Desbloquear la cámara de ${name} con un pase, desde $1.49 por 24 horas` : "Desbloquear con un pase, desde $1.49 por 24 horas"} class="btn-primary btn-sm">Desde $1.49 · 24 h</a>
    </div>
  )}

  {play && !locked && (
    <div class="absolute inset-0 flex items-center justify-center">
      <button
        type="button"
        aria-label={name ? `Reproducir cámara de ${name}` : "Reproducir cámara"}
        class="flex size-16 cursor-pointer items-center justify-center rounded-full bg-white shadow-md transition-transform hover:scale-105 md:size-20"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="#005279"></path></svg>
      </button>
    </div>
  )}

  <slot />
</div>
