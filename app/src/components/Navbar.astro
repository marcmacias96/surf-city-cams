---
import Logo from "./Logo.astro";

interface Props {
  /** Item de navegación activo */
  active?: "camaras" | "planes" | null;
  /** Estado del usuario para la demo */
  user?: "anonimo" | "pase" | null;
}
const { active = null } = Astro.props;

// El guard de /app redirige solo a /login si no hay sesión.
const items = [
  { id: "camaras", label: "Cámaras", href: "/app" },
  { id: "planes", label: "Planes", href: "/planes" },
];
---

<header class="sticky top-0 z-50 border-b border-ocean/10 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3.5 sm:px-6 lg:px-10">
    <Logo />
    <nav class="hidden items-center gap-8 font-heading text-[15px] font-semibold text-ocean-deep md:flex" aria-label="Navegación principal">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={[
            "pb-0.5 transition-colors hover:text-ocean",
            active === item.id && "border-b-2 border-terracotta text-ocean",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Con sesión iniciada: acceso directo a la plataforma -->
      <div data-nav-user class="hidden items-center gap-2.5 sm:gap-3">
        <a href="/app" class="flex items-center gap-2 rounded-full bg-terracotta-dark px-5 py-2 font-heading text-[15px] font-bold text-white transition-colors hover:bg-terracotta">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M2 17c3-5 6-5 9-2.5S18 17 22 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path d="M13 9c2.5-4 6-4.5 9-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          Mis cámaras
        </a>
      </div>
      <!-- Estado anónimo (por defecto) -->
      <div data-nav-anon class="flex items-center gap-2.5 sm:gap-3">
        <a href="/login" class="hidden rounded-full bg-secondary px-5 py-2 font-heading text-[15px] font-bold text-ocean transition-colors hover:bg-ocean/15 sm:block">Iniciar sesión</a>
        <a href="/planes" class="rounded-full bg-terracotta-dark px-5 py-2 font-heading text-[15px] font-bold text-white transition-colors hover:bg-terracotta">Ver planes</a>
      </div>
      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-movil"
        aria-label="Abrir menú"
        class="flex size-11 items-center justify-center rounded-full bg-ocean/[0.08] text-ocean-deep transition-colors hover:bg-ocean/15 md:hidden"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <nav id="nav-movil" class="hidden border-t border-ocean/10 bg-white px-4 pb-4 pt-3 md:hidden" aria-label="Navegación principal (móvil)">
    <ul class="flex flex-col gap-2">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex w-full items-center rounded-full px-5 py-3 font-heading text-[15px] font-bold",
              active === item.id
                ? "border border-terracotta bg-mist text-ocean"
                : "bg-mist text-ocean-deep",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li data-nav-anon>
        <a href="/login" class="flex w-full items-center rounded-full bg-secondary px-5 py-3 font-heading text-[15px] font-bold text-ocean sm:hidden">Iniciar sesión</a>
      </li>
      <li data-nav-user class="hidden">
        <a href="/app" class="flex w-full items-center rounded-full bg-terracotta-dark px-5 py-3 font-heading text-[15px] font-bold text-white">Mis cámaras</a>
      </li>
      <li data-nav-user class="hidden">
        <button type="button" data-logout class="flex w-full items-center rounded-full border border-ocean/20 px-5 py-3 font-heading text-[15px] font-bold text-ocean">Cerrar sesión</button>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { getSession, clearSession } from "@/lib/session";

  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-movil");
  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  });

  // El navbar de marketing refleja la sesión: anónimo por defecto; con
  // usuario logueado muestra el CTA de entrada a la plataforma.
  const session = getSession();
  if (session.user) {
    document.querySelectorAll<HTMLElement>("[data-nav-anon]").forEach((el) => el.classList.add("hidden"));
    document.querySelectorAll<HTMLElement>("[data-nav-user]").forEach((el) => {
      el.classList.remove("hidden");
      if (el.tagName !== "LI") el.classList.add("flex");
    });
  }
  document.querySelectorAll<HTMLElement>("[data-logout]").forEach((btn) => {
    btn.addEventListener("click", () => {
      clearSession();
      window.location.href = "/";
    });
  });
</script>
