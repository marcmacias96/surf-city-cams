    <Logo variant="light" size={26} />
    <p class="text-[13px] text-white/70">
      Surf City Ecuador · Manta y Montecristi, Manabí · surfcityecuador.com — Demo sin datos reales
    </p>
    <nav class="flex items-center gap-6 font-heading text-sm font-semibold text-white/85">
      <a href="/planes" class="py-2 hover:text-white">Planes</a>
      <a href="/planes#faq" class="py-2 hover:text-white">Soporte</a>
      <span class="py-2 text-white/55">Términos</span>
    </nav>
