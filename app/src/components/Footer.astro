---
import Logo from "./Logo.astro";
---

<!-- Footer (docs/BRAND.md → Footer): Navy Dark, links en sand / blanco al 60 %,
     divisor superior de 1px en #EFDEB1 para separarlo del contenido previo. -->
<footer class="border-t border-divider bg-navy-dark">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-5 py-7 sm:px-6 md:flex-row md:gap-4 md:py-6 lg:px-10">
    <Logo variant="light" size={22} />
    <p class="max-w-[340px] text-center text-[15px] leading-relaxed text-white/60 md:max-w-none md:text-[13px]">
      Surf City Ecuador · Manta y Montecristi, Manabí · surfcityecuador.com — Demo sin datos reales
    </p>
    <nav class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-heading text-sm font-semibold tracking-[0.06em] text-sand/90 md:gap-x-4" aria-label="Enlaces del pie">
      <a href="/planes" class="flex min-h-11 items-center px-3 transition-colors hover:text-white">Planes</a>
      <a href="/planes#como-funciona" class="flex min-h-11 items-center px-3 transition-colors hover:text-white">Soporte</a>
      <a href="/terminos" class="flex min-h-11 items-center px-3 transition-colors hover:text-white">Términos</a>
    </nav>
  </div>
</footer>
