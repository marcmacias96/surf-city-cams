---
interface Props {
  /** "light" para fondos oscuros */
  variant?: "dark" | "light";
  size?: number;
  /** Destino del logo: "/" en marketing, "/app" dentro de la plataforma */
  href?: string;
}
const { variant = "dark", size = 38, href = "/" } = Astro.props;
---

<a href={href} class="flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="19" cy="19" r="19" fill={variant === "dark" ? "#00527A" : "rgba(255,255,255,0.14)"}></circle>
    <path d="M7 23c4-6 8.5-6.5 12.5-3.5S28 23 32 18.5" stroke="#ffffff" stroke-width="2.6" fill="none" stroke-linecap="round"></path>
    <path d="M9 28c3-4 6.5-4.2 9.5-2.2s7.5 2 10.5-1.3" stroke="#7FD8F0" stroke-width="2" fill="none" stroke-linecap="round"></path>
  </svg>
  <span
    class:list={[
      "font-heading font-bold tracking-wide",
      variant === "dark" ? "text-ocean-deep" : "text-white",
    ]}
    style={`font-size: ${Math.round(size * 0.66)}px`}
  >
    Surf<span class:list={[variant === "dark" ? "text-ocean" : "text-seafoam"]}>City</span>
    <span class:list={["hidden font-normal tracking-widest sm:inline", variant === "dark" ? "text-muted-foreground" : "text-white/70"]} style={`font-size: ${Math.round(size * 0.4)}px`}>CAMS</span>
  </span>
</a>
