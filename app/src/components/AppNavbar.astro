---
import Logo from "./Logo.astro";

interface Props {
  /** Item de navegación activo */
  active?: "camaras" | "mipase" | "planes" | null;
}
const { active = null } = Astro.props;

const items = [
  { id: "camaras", label: "Cámaras", href: "/app" },
  { id: "mipase", label: "Mi pase", href: "/cuenta" },
  { id: "planes", label: "Mejorar plan", href: "/planes" },
];
---

<!-- Guardia de sesión: sin usuario, a /login. Va antes del render visible
     para que el flash de contenido protegido sea mínimo. -->
<script>
  import { getUser } from "@/lib/session";
  if (!getUser()) {
    window.location.replace("/login?next=" + encodeURIComponent(location.pathname));
  }
</script>

<header class="sticky top-0 z-50 border-b border-white/10 bg-ocean-deep">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-10">
    <Logo variant="light" size={30} href="/app" />
    <nav class="hidden items-center gap-7 font-heading text-[15px] font-semibold text-white/80 md:flex" aria-label="Navegación de la plataforma">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={[
            "pb-0.5 transition-colors hover:text-white",
            active === item.id && "border-b-2 border-terracotta text-white",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Chip de estado del pase/suscripción: lo pinta el script de sesión -->
      <a href="/cuenta" data-app-estado class="hidden items-center gap-2 rounded-full bg-sand px-4 py-2">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.5 6.8L12 16.8 5.9 20.3l1.5-6.8L2.2 8.9l6.9-.6z" fill="#6E5528"></path></svg>
        <span data-session-label class="font-heading text-[13px] font-bold text-sand-dark">Pase activo</span>
      </a>
      <div class="hidden items-center gap-2.5 md:flex">
        <span data-app-avatar aria-hidden="true" class="flex size-9 items-center justify-center rounded-full bg-seafoam font-heading text-[15px] font-bold text-ocean-deep">S</span>
        <span data-app-nombre class="max-w-[120px] truncate font-heading text-sm font-semibold text-white">Surfista</span>
      </div>
      <button
        type="button"
        data-app-salir
        class="hidden rounded-full border border-white/30 px-4 py-2 font-heading text-sm font-bold text-white transition-colors hover:border-destructive hover:bg-destructive/20 md:block"
      >
        Salir
      </button>
      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-movil"
        aria-label="Abrir menú"
        class="flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 md:hidden"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <nav id="nav-movil" class="hidden border-t border-white/10 bg-ocean-deep px-4 pb-4 pt-3 md:hidden" aria-label="Navegación de la plataforma (móvil)">
    <ul class="flex flex-col gap-2">
      <li class="flex items-center gap-2.5 px-2 pb-1.5">
        <span data-app-avatar aria-hidden="true" class="flex size-9 items-center justify-center rounded-full bg-seafoam font-heading text-[15px] font-bold text-ocean-deep">S</span>
        <span data-app-nombre class="truncate font-heading text-[15px] font-bold text-white">Surfista</span>
      </li>
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex w-full items-center rounded-full px-5 py-3 font-heading text-[15px] font-bold",
              active === item.id
                ? "border border-terracotta bg-white/10 text-white"
                : "bg-white/[0.07] text-white/85",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <button type="button" data-app-salir class="flex w-full items-center rounded-full border border-white/30 px-5 py-3 font-heading text-[15px] font-bold text-white">
          Salir
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { getSession, activePasses, remainingMs, fmtRemaining, clearSession } from "@/lib/session";

  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-movil");
  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  });

  const session = getSession();

  // Avatar + nombre del usuario mock.
  if (session.user) {
    const inicial = (session.user.name.trim().charAt(0) || "S").toUpperCase();
    document.querySelectorAll<HTMLElement>("[data-app-avatar]").forEach((el) => (el.textContent = inicial));
    document.querySelectorAll<HTMLElement>("[data-app-nombre]").forEach((el) => (el.textContent = session.user!.name));
  }

  // Chip de estado: pase activo o plan de suscripción.
  const pases = activePasses(session);
  if (pases.length > 0 || session.subscription !== null) {
    // El chip queda oculto en móvil (hidden) y visible desde sm (sm:flex).
    document.querySelector<HTMLElement>("[data-app-estado]")?.classList.add("sm:flex");
    const label = document.querySelector<HTMLElement>("[data-session-label]");
    if (label) {
      label.textContent = session.subscription
        ? `Plan ${session.subscription.name}`
        : `Pase activo · ${fmtRemaining(Math.max(...pases.map((p) => remainingMs(p))))}`;
    }
  }

  document.querySelectorAll<HTMLElement>("[data-app-salir]").forEach((btn) => {
    btn.addEventListener("click", () => {
      clearSession();
      window.location.href = "/";
    });
  });
</script>
