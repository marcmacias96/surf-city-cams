---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
---

<Layout title="Iniciar sesión">
  <main class="flex min-h-screen flex-col items-center justify-center bg-foam px-5 py-10 sm:px-6 sm:py-12">
    <div class="flex w-full max-w-[420px] flex-col items-center gap-6 rounded-2xl border border-divider bg-white p-6 shadow-sm sm:p-10">
      <Logo layout="stacked" size={96} />
      <div class="flex flex-col items-center gap-2 text-center">
        <h1 class="font-heading text-[26px] font-bold text-navy">Entra a SurfCity Cams</h1>
        <p class="text-[15px] text-muted-foreground sm:text-[13px]">Demo sin contraseña ni datos reales.</p>
      </div>

      <form id="login-form" class="flex w-full flex-col gap-4" novalidate>
        <label class="flex flex-col gap-1.5">
          <span class="font-heading text-sm font-semibold text-navy">Nombre <span class="font-normal text-muted-foreground">(opcional)</span></span>
          <input
            id="login-nombre"
            type="text"
            name="nombre"
            autocomplete="off"
            placeholder="Tu nombre"
            class="w-full rounded-full border border-navy/20 bg-white px-5 py-3 text-[15px] text-ink outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-navy"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="font-heading text-sm font-semibold text-navy">Email <span class="font-normal text-muted-foreground">(opcional)</span></span>
          <input
            id="login-email"
            type="email"
            name="email"
            autocomplete="off"
            placeholder="tucorreo@ejemplo.com"
            class="w-full rounded-full border border-navy/20 bg-white px-5 py-3 text-[15px] text-ink outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-navy"
          />
        </label>
        <button type="submit" class="btn-primary btn-block mt-1">
          Entrar a la demo
        </button>
      </form>

      <button id="login-invitado" type="button" class="flex min-h-11 items-center px-3 font-heading text-sm font-semibold text-navy underline-offset-4 transition-colors hover:text-navy-dark hover:underline">
        Entrar como invitado
      </button>
    </div>
    <p class="mt-4 text-[15px] text-muted-foreground sm:mt-6 sm:text-[13px]">
      <a href="/" class="inline-flex min-h-11 items-center px-3 font-semibold text-navy hover:text-navy-dark">← Volver al inicio</a>
    </p>
  </main>

  <script>
    import { getUser, login } from "@/lib/session";

    // Destino tras el login: solo rutas internas ("/...") para evitar open redirect.
    function destino(): string {
      const next = new URLSearchParams(location.search).get("next");
      return next && next.startsWith("/") && !next.startsWith("//") ? next : "/app";
    }

    // Ya hay sesión con usuario: entra directo.
    if (getUser()) {
      window.location.replace(destino());
    }

    document.getElementById("login-form")?.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const nombre = (document.getElementById("login-nombre") as HTMLInputElement | null)?.value.trim() || "Invitado";
      const email = (document.getElementById("login-email") as HTMLInputElement | null)?.value.trim() || "";
      login(nombre, email);
      window.location.href = destino();
    });

    document.getElementById("login-invitado")?.addEventListener("click", () => {
      login("Invitado", "");
      window.location.href = destino();
    });
  </script>
</Layout>
