---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
---

<Layout title="Iniciar sesión">
  <main class="flex min-h-screen flex-col items-center justify-center bg-mist px-6 py-12">
    <div class="flex w-full max-w-[420px] flex-col items-center gap-6 rounded-3xl border border-ocean/10 bg-white p-8 shadow-[0_20px_50px_rgba(0,58,87,0.12)] sm:p-10">
      <Logo />
      <div class="flex flex-col items-center gap-2 text-center">
        <h1 class="font-heading text-[26px] font-bold tracking-wide text-ocean-deep">Entra a SurfCity Cams</h1>
        <p class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3.5 py-1.5 text-[13px] font-semibold text-sand-dark">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" stroke="#6E5528" stroke-width="2"></circle><path d="M12 8v5M12 16.5v.01" stroke="#6E5528" stroke-width="2" stroke-linecap="round"></path></svg>
          Demo: no pedimos contraseña ni datos reales
        </p>
      </div>

      <form id="login-form" class="flex w-full flex-col gap-4" novalidate>
        <label class="flex flex-col gap-1.5">
          <span class="font-heading text-sm font-semibold text-ocean-deep">Nombre <span class="font-normal text-muted-foreground">(opcional)</span></span>
          <input
            id="login-nombre"
            type="text"
            name="nombre"
            autocomplete="off"
            placeholder="¿Cómo te llamamos?"
            class="w-full rounded-full border border-ocean/20 bg-white px-5 py-3 text-[15px] text-ocean-deep outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-ocean"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="font-heading text-sm font-semibold text-ocean-deep">Email <span class="font-normal text-muted-foreground">(opcional)</span></span>
          <input
            id="login-email"
            type="email"
            name="email"
            autocomplete="off"
            placeholder="tucorreo@ejemplo.com"
            class="w-full rounded-full border border-ocean/20 bg-white px-5 py-3 text-[15px] text-ocean-deep outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-ocean"
          />
        </label>
        <button type="submit" class="mt-1 rounded-full bg-terracotta-dark px-6 py-3.5 font-heading text-[16px] font-bold text-white transition-colors hover:bg-terracotta">
          Entrar a la demo
        </button>
      </form>

      <button id="login-invitado" type="button" class="font-heading text-sm font-semibold text-ocean underline-offset-4 transition-colors hover:text-ocean-deep hover:underline">
        Entrar como invitado
      </button>
    </div>
    <p class="mt-6 text-[13px] text-muted-foreground">
      <a href="/" class="font-semibold text-ocean hover:text-ocean-deep">← Volver al inicio</a>
    </p>
  </main>

  <script>
    import { getUser, login } from "@/lib/session";

    // Destino tras el login: solo rutas internas ("/...") para evitar open redirect.
    function destino(): string {
      const next = new URLSearchParams(location.search).get("next");
      return next && next.startsWith("/") && !next.startsWith("//") ? next : "/app";
    }

    // Ya hay sesión con usuario: entra directo.
    if (getUser()) {
      window.location.replace(destino());
    }

    document.getElementById("login-form")?.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const nombre = (document.getElementById("login-nombre") as HTMLInputElement | null)?.value.trim() || "Invitado";
      const email = (document.getElementById("login-email") as HTMLInputElement | null)?.value.trim() || "";
      login(nombre, email);
      window.location.href = destino();
    });

    document.getElementById("login-invitado")?.addEventListener("click", () => {
      login("Invitado", "");
      window.location.href = destino();
    });
  </script>
</Layout>
