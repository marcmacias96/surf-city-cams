---
import Layout from "@/layouts/Layout.astro";
import AppNavbar from "@/components/AppNavbar.astro";
import Footer from "@/components/Footer.astro";
import CuentaPanel from "@/components/cuenta/CuentaPanel.tsx";
---

<Layout title="Mi cuenta">
  <AppNavbar active="mipase" />

  <main class="flex flex-1 flex-col bg-foam">
    <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col items-start gap-6 px-5 pb-14 pt-6 sm:gap-8 sm:px-6 sm:pt-11 lg:flex-row lg:items-stretch lg:px-10">
      <!-- CuentaPanel controla todo el layout de la columna: aside (tabs
           sincronizados con ?tab=) + contenido, según la sección activa. -->
      <CuentaPanel client:load />
    </div>
  </main>

  <Footer />
</Layout>
