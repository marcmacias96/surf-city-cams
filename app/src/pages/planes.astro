---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import PlanPricing from "@/components/planes/PlanPricing";

/** Cómo funciona el pase: lista editorial numerada, sin iconos */
const steps = [
  {
    title: "Compra el pase",
    text: "Eliges los spots y la duración: 24 horas, 48 horas, 7 o 15 días. Pagas con tarjeta, transferencia o pago móvil y recibes un código.",
  },
  {
    title: "Se activa con la primera vista",
    text: "El tiempo empieza a contar cuando abres la primera cámara, no cuando pagas. Puedes comprarlo hoy y usarlo el sábado.",
  },
  {
    title: "Cámara y forecast mientras dure",
    text: "Vídeo en vivo y forecast a 4 días de cada spot incluido. Cuando expira, compras otro pase o te pasas a la suscripción Local.",
  },
];
---

<Layout title="Planes">
  <div class="min-h-screen bg-foam">
    <Navbar active="planes" user="anonimo" />

    <main class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10">
      <!-- Header -->
      <section class="flex flex-col items-center gap-3.5 pb-8 pt-10 text-center sm:pb-9 sm:pt-14">
        <h1 class="font-heading text-[34px] font-bold text-navy sm:text-4xl md:text-[42px]">
          Elige cómo quieres ver el mar
        </h1>
        <p class="max-w-[620px] text-base leading-relaxed text-muted-foreground sm:text-[17px]">
          Suscripción mensual con las nueve cámaras, o pases por spot y por tiempo. Sin permanencia.
        </p>
      </section>

      <!-- Toggle + plan cards (isla interactiva) -->
      <section class="pb-6">
        <PlanPricing client:load />
      </section>

      <!-- Cómo funciona el pase -->
      <section id="como-funciona" class="mt-6 mb-14">
        <div class="flex flex-col gap-8 rounded-2xl border border-divider bg-white p-6 sm:gap-10 sm:p-9 lg:flex-row lg:gap-16 lg:px-10">
          <div class="flex w-full flex-col gap-3 lg:w-[380px] lg:shrink-0">
            <p class="font-heading text-[13px] font-bold uppercase tracking-[0.12em] text-muted-foreground sm:text-xs">Cómo funciona el pase</p>
            <h2 class="font-heading text-2xl leading-tight font-bold text-navy sm:text-[26px]">
              El pase se activa cuando abres la cámara
            </h2>
            <p class="text-[15px] leading-relaxed text-muted-foreground">
              Al comprar recibes un código único. Elige los spots y la duración; el contador arranca con tu primera vista y, al terminar, el pase expira sin renovarse.
            </p>
          </div>
          <ol class="flex w-full flex-1 flex-col divide-y divide-divider">
            {steps.map((step, i) => (
              <li class="grid grid-cols-[2.25rem_1fr] gap-x-3 py-5 first:pt-0 last:pb-0 sm:grid-cols-[2.5rem_1fr] sm:gap-x-4">
                <span class="font-heading text-2xl font-bold leading-none text-terracotta">{String(i + 1).padStart(2, "0")}</span>
                <div class="flex flex-col gap-1">
                  <h3 class="font-heading text-base font-bold text-navy">{step.title}</h3>
                  <p class="text-[15px] leading-relaxed text-ink">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
