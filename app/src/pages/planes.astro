---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import PlanPricing from "@/components/planes/PlanPricing";

const steps = [
  {
    title: "Compra tu pase",
    text: "Tarjeta, transferencia o pago móvil",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="7" width="18" height="12" rx="2.5" stroke="#00527A" stroke-width="2"></rect><path d="M12 11v4M10 13h4" stroke="#00527A" stroke-width="2" stroke-linecap="round"></path></svg>`,
  },
  {
    title: "Se activa al usarlo",
    text: "El contador corre desde tu primera vista",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="#00527A" stroke-width="2"></circle><path d="M12 7v5l3.5 2" stroke="#00527A" stroke-width="2" stroke-linecap="round"></path></svg>`,
  },
  {
    title: "Mira tus spots",
    text: "Cámara + forecast mientras dure el pase",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 18c3-5 6-5 9-2.5S18 18 22 14" stroke="#00527A" stroke-width="2" stroke-linecap="round"></path><path d="M13 9c2.5-4 6-4.5 9-2" stroke="#00527A" stroke-width="2" stroke-linecap="round"></path></svg>`,
  },
];
---

<Layout title="Planes">
  <div class="min-h-screen bg-mist">
    <Navbar active="planes" user="anonimo" />

    <main class="mx-auto max-w-7xl px-6 lg:px-10">
      <!-- Header -->
      <section class="flex flex-col items-center gap-3.5 pt-14 pb-9 text-center">
        <h1 class="font-heading text-4xl font-bold tracking-[0.8px] text-ocean-deep md:text-[42px]">
          Elige cómo quieres ver el mar
        </h1>
        <p class="max-w-[620px] text-[17px] leading-relaxed text-muted-foreground">
          Acceso total con suscripción, o pases puntuales por spot y por tiempo. Sin permanencia: cancela cuando quieras.
        </p>
      </section>

      <!-- Toggle + plan cards (isla interactiva) -->
      <section class="pb-6">
        <PlanPricing client:load />
      </section>

      <!-- Cómo funciona el pase -->
      <section class="mt-6 mb-14">
        <div class="flex flex-col items-center gap-10 rounded-2xl border border-ocean/10 bg-white p-9 lg:flex-row lg:gap-11 lg:px-10">
          <div class="flex w-full flex-col gap-3 lg:w-[380px] lg:shrink-0">
            <div class="inline-flex items-center gap-2 self-start rounded-2xl bg-sand px-3.5 pt-1.5 pb-1">
              <span class="font-heading text-xs font-bold tracking-[1px] text-sand-dark">¿CÓMO FUNCIONA EL PASE?</span>
            </div>
            <h2 class="font-heading text-[26px] leading-tight font-bold text-ocean-deep">
              Un pase, tus spots, tu tiempo
            </h2>
            <p class="text-[15px] leading-relaxed text-muted-foreground">
              Al comprar recibes un pase con un código único que se activa en tu primer uso. Elige los spots y la duración; cuando el tiempo termina, el pase expira y puedes comprar otro o pasarte a la suscripción.
            </p>
          </div>
          <div class="flex w-full flex-1 flex-col items-center gap-6 md:flex-row md:gap-0">
            {
              steps.map((step, i) => (
                <>
                  {i > 0 && (
                    <svg
                      width="40"
                      height="14"
                      viewBox="0 0 40 14"
                      xmlns="http://www.w3.org/2000/svg"
                      class="shrink-0 rotate-90 md:rotate-0"
                    >
                      <path d="M2 7h32M30 2l6 5-6 5" stroke="#DC8158" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  <div class="flex flex-1 flex-col items-center gap-2.5 text-center">
                    <div class="flex size-[54px] items-center justify-center rounded-full bg-ocean/8" set:html={step.icon} />
                    <div class="font-heading text-[15px] font-bold text-ocean-deep">{step.title}</div>
                    <div class="max-w-[170px] text-[13px] text-muted-foreground">{step.text}</div>
                  </div>
                </>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
