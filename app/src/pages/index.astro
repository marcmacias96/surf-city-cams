---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import CamSurface from "@/components/CamSurface.astro";
import { spots } from "@/data/spots";

const featured = spots.find((s) => s.slug === "el-sombrero")!;

/** Teaser de marketing: 3 spots destacados con foto */
const teaser = ["el-sombrero", "marianita", "san-jose"].map(
  (slug) => spots.find((s) => s.slug === slug)!,
);

/** Cómo funciona: lista editorial numerada, sin iconos */
const pasos = [
  {
    title: "Elige el spot",
    text: "Nueve cámaras fijas entre San Mateo y Montecristi. Cada una con su forecast de olas, viento y marea.",
  },
  {
    title: "Pase o suscripción",
    text: "Un pase cubre uno o varios spots por 24 horas, 48 horas, 7 o 15 días, desde $1.49. La suscripción Local abre las nueve cámaras por $7.99 al mes.",
  },
  {
    title: "Mira el mar antes de salir",
    text: "El pase se activa con la primera vista. Revisa Faro 1 o El Sombrero desde casa y decide si vale la pena manejar.",
  },
];
---

<Layout title="Cámaras de surf en vivo">
  <Navbar />

  <main>
    <!-- Hero: fondo sólido Navy Dark (docs/BRAND.md → sin gradientes llamativos) -->
    <section class="bg-navy-dark">
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-10 px-5 py-12 sm:px-6 sm:py-16 lg:flex-row lg:gap-14 lg:px-10 lg:py-20">
        <div class="flex flex-1 flex-col gap-5">
          <p class="font-heading text-[15px] font-semibold text-white/70">Manta y Montecristi, Manabí</p>
          <h1 class="max-w-[560px] font-heading text-4xl font-bold leading-[1.1] text-white sm:text-[44px] md:text-[54px]">
            Las olas de Manabí, en vivo.
          </h1>
          <p class="max-w-[520px] text-[17px] leading-relaxed text-white/85 sm:text-lg">
            Nueve cámaras sobre los spots de San Mateo, Santa Marianita y Montecristi, con forecast de olas, viento y marea. Compra un pase por horas o días, o suscríbete al mes.
          </p>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-3.5">
            <a href="/login" class="btn-primary btn-lg btn-block sm:w-auto">Probar la demo</a>
            <a href="/planes" class="btn-secondary-light btn-lg btn-block sm:w-auto">Ver planes</a>
          </div>
          <p class="text-[15px] text-white/70">Pases desde $1.49 · Suscripción Local $7.99/mes</p>
        </div>

        <!-- Cámara destacada -->
        <a href="/login?next=/spots/el-sombrero" class="block w-full max-w-[480px] overflow-hidden rounded-2xl bg-white shadow-lg lg:w-[480px]">
          <CamSurface gradient={featured.gradient} image={featured.image} play name={featured.name} badge="1080p" class="aspect-[16/10] sm:aspect-auto sm:h-[270px]" />
          <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col gap-0.5">
              <span class="font-heading text-xl font-bold text-navy">{featured.name}</span>
              <span class="text-[13px] text-muted-foreground">{featured.breakType} · {featured.localidad}, Manabí</span>
            </div>
            <div class="flex gap-2">
              <span class="flex items-center gap-1.5 rounded-full bg-foam px-2.5 py-1">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M2 17c3-5 6-5 9-2.5S18 17 22 13" stroke="#005279" stroke-width="2" stroke-linecap="round"></path><path d="M13 9c2.5-4 6-4.5 9-2" stroke="#005279" stroke-width="2" stroke-linecap="round"></path></svg>
                <span class="text-xs font-semibold text-ink">{featured.waveM.toFixed(1)} m</span>
              </span>
              <span class="flex items-center gap-1.5 rounded-full bg-foam px-2.5 py-1">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M3 8h9a3 3 0 1 0-3-3M3 12h13a3 3 0 1 1-3 3M3 16h6" stroke="#2EAA6B" stroke-width="2" stroke-linecap="round"></path></svg>
                <span class="text-xs font-semibold text-success-ink">Offshore</span>
              </span>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- Teaser: 3 spots con foto -->
    <section class="mx-auto flex max-w-7xl flex-col gap-7 px-5 pb-6 pt-12 sm:px-6 sm:pt-16 lg:px-10">
      <div class="flex flex-col gap-2">
        <h2 class="font-heading text-2xl font-bold text-navy md:text-[28px]">Nueve spots en 30 km de costa</h2>
        <p class="text-base text-muted-foreground">De Faro 1, en San Mateo, a San José, en Montecristi. Cada cámara con forecast de olas, viento y marea.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {teaser.map((spot) => (
          <a
            href={`/login?next=/spots/${spot.slug}`}
            class="group block overflow-hidden rounded-2xl border border-divider bg-white transition-colors hover:border-navy/40"
          >
            <CamSurface
              gradient={spot.gradient}
              image={spot.image}
              name={spot.name}
              badge={spot.access === "premium" ? "PREMIUM" : spot.access === "gratis" ? "GRATIS" : "CON PASE"}
              class="h-[200px]"
            />
            <div class="flex items-center justify-between gap-3 p-5">
              <div class="flex flex-col gap-0.5">
                <span class="font-heading text-lg font-bold text-navy">{spot.name}</span>
                <span class="text-[13px] text-muted-foreground">{spot.breakType} · {spot.localidad}</span>
              </div>
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-navy/[0.08] text-navy transition-colors group-hover:bg-terracotta group-hover:text-white">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
      <a href="/login?next=/app" class="inline-flex min-h-11 items-center self-start font-heading text-[15px] font-bold text-navy transition-colors hover:text-navy-dark">
        Ver los 9 spots en el mapa →
      </a>
    </section>

    <!-- Cómo funciona: lista editorial numerada -->
    <section class="mx-auto max-w-7xl px-5 pb-14 pt-8 sm:px-6 sm:pb-16 sm:pt-12 lg:px-10">
      <div class="flex flex-col gap-8 rounded-2xl border border-divider bg-foam p-6 sm:gap-10 sm:p-8 lg:flex-row lg:gap-16 lg:p-11">
        <div class="flex flex-col gap-2.5 lg:w-[340px] lg:shrink-0">
          <h2 class="font-heading text-[26px] font-bold leading-tight text-navy sm:text-[28px]">Paga solo los días que vas al agua</h2>
          <p class="text-[15px] leading-relaxed text-muted-foreground">Pases por horas o días para uno o varios spots, o una suscripción mensual con las nueve cámaras.</p>
        </div>
        <ol class="flex flex-1 flex-col divide-y divide-divider">
          {pasos.map((paso, i) => (
            <li class="grid grid-cols-[2.25rem_1fr] gap-x-3 py-5 first:pt-0 last:pb-0 sm:grid-cols-[2.5rem_1fr] sm:gap-x-4">
              <span class="font-heading text-2xl font-bold leading-none text-terracotta">{String(i + 1).padStart(2, "0")}</span>
              <div class="flex flex-col gap-1">
                <h3 class="font-heading text-base font-bold text-navy">{paso.title}</h3>
                <p class="text-[15px] leading-relaxed text-ink">{paso.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Cierre -->
    <section class="bg-navy-dark">
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-5 px-5 py-12 text-center sm:px-6 sm:py-14 lg:px-10">
        <h2 class="font-heading text-[28px] font-bold text-white sm:text-3xl md:text-[34px]">Revisa El Sombrero antes de cargar la tabla</h2>
        <p class="max-w-[480px] text-base leading-relaxed text-white/75">La demo abre las nueve cámaras de Manta y Montecristi con su forecast. Sin contraseña ni datos reales.</p>
        <a href="/login" class="btn-primary btn-lg">Entrar a la demo</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
