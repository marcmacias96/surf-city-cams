---
import Layout from "@/layouts/Layout.astro";
import AppNavbar from "@/components/AppNavbar.astro";
import Footer from "@/components/Footer.astro";
import { spots } from "@/data/spots";
---

<Layout title="Tus cámaras">
  <AppNavbar active="camaras" />

  <main class="bg-foam">
    <!-- Encabezado del dashboard -->
    <section class="mx-auto flex max-w-7xl flex-col gap-1.5 px-5 pt-7 sm:px-6 sm:pt-10 lg:px-10">
      <p data-app-saludo class="font-heading text-[15px] font-semibold text-terracotta">Buenas olas</p>
      <h1 class="font-heading text-3xl font-bold text-navy md:text-[36px]">Tus cámaras</h1>
      <p class="text-base text-muted-foreground">Los 9 spots de Manta y Montecristi, en vivo y con forecast.</p>
    </section>

    <!-- Spots grid -->
    <section id="spots" class="mx-auto flex max-w-7xl scroll-mt-24 flex-col gap-6 px-5 pb-6 pt-7 sm:gap-7 sm:px-6 sm:pt-8 lg:px-10">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col gap-2">
          <h2 class="font-heading text-2xl font-bold text-navy md:text-[28px]">Cámaras por spot</h2>
          <p class="text-base text-muted-foreground">Manta y Montecristi, Manabí · actualizado hace 2 min</p>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar spots por nivel">
          <button type="button" data-filter="" aria-pressed="true" class="min-h-11 rounded-full px-[18px] py-2.5 font-heading text-sm font-semibold transition-colors aria-pressed:bg-navy aria-pressed:text-white bg-navy/[0.08] text-navy hover:bg-navy/15 aria-pressed:hover:bg-navy">Todos</button>
          <button type="button" data-filter="principiante" aria-pressed="false" class="min-h-11 rounded-full px-[18px] py-2.5 font-heading text-sm font-semibold transition-colors aria-pressed:bg-navy aria-pressed:text-white bg-navy/[0.08] text-navy hover:bg-navy/15 aria-pressed:hover:bg-navy">Principiante</button>
          <button type="button" data-filter="intermedio" aria-pressed="false" class="min-h-11 rounded-full px-[18px] py-2.5 font-heading text-sm font-semibold transition-colors aria-pressed:bg-navy aria-pressed:text-white bg-navy/[0.08] text-navy hover:bg-navy/15 aria-pressed:hover:bg-navy">Intermedio</button>
          <button type="button" data-filter="avanzado" aria-pressed="false" class="min-h-11 rounded-full px-[18px] py-2.5 font-heading text-sm font-semibold transition-colors aria-pressed:bg-navy aria-pressed:text-white bg-navy/[0.08] text-navy hover:bg-navy/15 aria-pressed:hover:bg-navy">Avanzado</button>
        </div>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-[1.08fr_1fr] lg:gap-8">
        <!-- En desktop el mapa va primero; en móvil la lista abre la sección
             y el mapa (más bajo) queda después, sin atrapar el scroll táctil. -->
        <div class="order-2 overflow-hidden rounded-2xl border border-divider lg:order-1">
          <iframe
            id="spots-map"
            src="/mapa.html"
            loading="lazy"
            title="Mapa de spots de surf de Manta y Manabí"
            class="block h-full min-h-[400px] w-full border-0 md:min-h-[min(80vh,780px)]"></iframe>
        </div>

        <div id="spots-list" class="order-1 flex flex-col gap-3 lg:order-2">
          {spots.map((spot) => (
            <div
              data-row
              data-nivel={spot.nivel}
              class="group flex items-center gap-3 rounded-2xl border border-divider bg-white p-3 pr-4 transition-colors hover:border-navy/40 data-[on=true]:ring-2 data-[on=true]:ring-inset data-[on=true]:ring-navy sm:gap-4"
            >
              <button
                type="button"
                data-spot={spot.slug}
                aria-pressed="false"
                aria-label={`Ver ${spot.name} en el mapa`}
                class="flex min-w-0 flex-1 cursor-pointer items-center gap-3 rounded-xl text-left sm:gap-4"
              >
                <div class:list={["relative h-[46px] w-[68px] shrink-0 overflow-hidden rounded-xl bg-gradient-to-br sm:h-[54px] sm:w-[84px]", spot.gradient]}>
                  <img src={spot.image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
                  {spot.access === "bloqueado" ? (
                    <>
                      <div data-lock-ui class="absolute inset-0 flex items-center justify-center bg-navy-dark/30">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="9" rx="2" stroke="#ffffff" stroke-width="2"></rect><path d="M8 11V8a4 4 0 1 1 8 0v3" stroke="#ffffff" stroke-width="2"></path></svg>
                      </div>
                      <span data-live-ui class="live-dot absolute left-1.5 top-1.5 hidden size-1.5 rounded-full bg-destructive"></span>
                    </>
                  ) : (
                    <span class="live-dot absolute left-1.5 top-1.5 inline-block size-1.5 rounded-full bg-destructive"></span>
                  )}
                </div>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <div class="flex items-center gap-2">
                    <span class="truncate font-heading text-[17px] font-bold text-navy">{spot.name}</span>
                    {spot.access === "gratis" && (
                      <span title="Cámara gratis" class="flex size-[22px] shrink-0 items-center justify-center rounded-full bg-success/95">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M6 12.5l4 4 8-9" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                        <span class="sr-only">Gratis</span>
                      </span>
                    )}
                    {spot.access === "premium" && (
                      <span data-access-badge title="Spot premium" class="flex size-[22px] shrink-0 items-center justify-center rounded-full bg-navy-dark/85">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.5 6.8L12 16.8 5.9 20.3l1.5-6.8L2.2 8.9l6.9-.6z" fill="#EFDEB1"></path></svg>
                        <span class="sr-only">Premium</span>
                      </span>
                    )}
                    {spot.access === "bloqueado" && (
                      <span data-access-badge title="Requiere pase" class="flex size-[22px] shrink-0 items-center justify-center rounded-full bg-sand">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="9" rx="2" stroke="#6E5528" stroke-width="2.5"></rect><path d="M8 11V8a4 4 0 1 1 8 0v3" stroke="#6E5528" stroke-width="2.5"></path></svg>
                        <span class="sr-only">Requiere pase</span>
                      </span>
                    )}
                    {spot.access !== "gratis" && (
                      <span data-owned-badge title="Incluido en tu pase" class="hidden size-[22px] shrink-0 items-center justify-center rounded-full bg-success/95">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M6 12.5l4 4 8-9" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                        <span class="sr-only">Incluido en tu pase</span>
                      </span>
                    )}
                  </div>
                  <span class="text-xs text-muted-foreground">{spot.breakType} · {spot.localidad}</span>
                  <div class="flex flex-wrap items-center gap-1.5 sm:hidden">
                    <span class="rounded-full bg-foam px-2 py-0.5 text-[11px] font-semibold text-ink">{spot.waveM.toFixed(1)} m</span>
                    {spot.offshore && <span class="rounded-full bg-foam px-2 py-0.5 text-[11px] font-semibold text-success-ink">Offshore</span>}
                  </div>
                </div>
                <div class="hidden items-center gap-2 sm:flex">
                  <span class="flex items-center gap-1.5 rounded-full bg-foam px-2.5 py-1">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M2 17c3-5 6-5 9-2.5S18 17 22 13" stroke="#005279" stroke-width="2" stroke-linecap="round"></path></svg>
                    <span class="text-xs font-semibold text-ink">{spot.waveM.toFixed(1)} m</span>
                  </span>
                  {spot.offshore && (
                    <span class="flex items-center gap-1.5 rounded-full bg-foam px-2.5 py-1">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M3 8h9a3 3 0 1 0-3-3M3 12h13a3 3 0 1 1-3 3" stroke="#2EAA6B" stroke-width="2" stroke-linecap="round"></path></svg>
                      <span class="text-xs font-semibold text-success-ink">Offshore</span>
                    </span>
                  )}
                </div>
              </button>
              <a
                href={`/spots/${spot.slug}`}
                aria-label={`Ver cámara de ${spot.name}`}
                class="flex size-11 shrink-0 items-center justify-center rounded-full bg-navy/[0.08] text-navy transition-colors hover:bg-terracotta hover:text-white"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <script>
      import { spots } from "@/data/spots";
      import { isSpotUnlocked, getSession } from "@/lib/session";

      // Saludo con el nombre del usuario mock.
      const saludo = document.querySelector<HTMLElement>("[data-app-saludo]");
      const user = getSession().user;
      if (saludo && user?.name) saludo.textContent = `Buenas olas, ${user.name}`;

      // La sesión local desbloquea spots comprados: se reflejan en la lista
      // (badge TU PASE, sin candado) y en el mapa (marcador verde accesible).
      const sesion = getSession();
      const desbloqueado = (slug: string) => isSpotUnlocked(slug, sesion);

      const spotsDelMapa = spots.map((s) => ({
        slug: s.slug,
        name: s.name,
        breakType: s.breakType,
        waveM: s.waveM,
        access: s.access !== "gratis" && desbloqueado(s.slug) ? "gratis" : s.access,
        lat: s.lat,
        lon: s.lon,
      }));

      document.querySelectorAll<HTMLElement>("#spots-list [data-row]").forEach((row) => {
        const btn = row.querySelector<HTMLElement>("[data-spot]");
        const slug = btn?.dataset.spot;
        if (!slug || !desbloqueado(slug)) return;
        row.querySelector("[data-lock-ui]")?.remove();
        row.querySelector<HTMLElement>("[data-live-ui]")?.classList.replace("hidden", "inline-block");
        row.querySelector<HTMLElement>("[data-access-badge]")?.classList.add("hidden");
        const owned = row.querySelector<HTMLElement>("[data-owned-badge]");
        if (owned) {
          owned.classList.remove("hidden");
          owned.classList.add("flex");
        }
      });

      const mapEl = document.getElementById("spots-map") as HTMLIFrameElement | null;
      const btns = Array.from(document.querySelectorAll<HTMLButtonElement>("#spots-list [data-spot]"));
      const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
      let selected: string | null = null;
      let nivel: string | null = null;
      let mapTimer: number | undefined;

      const nivelOf = (slug: string) => spots.find((s) => s.slug === slug)?.nivel ?? null;

      function syncMap() {
        const frame = mapEl?.contentWindow;
        if (!frame) return;
        const visibles = nivel ? spotsDelMapa.filter((s) => nivelOf(s.slug) === nivel) : spotsDelMapa;
        const send = () => frame.postMessage({ source: "surfcity-app", spots: visibles, selected }, "*");
        send();
        clearTimeout(mapTimer);
        mapTimer = window.setTimeout(send, 800);
      }

      function paint() {
        btns.forEach((btn) => {
          const on = btn.dataset.spot === selected;
          btn.setAttribute("aria-pressed", String(on));
          const row = btn.closest<HTMLElement>("[data-row]");
          if (row) row.dataset.on = String(on);
        });
      }

      function choose(slug: string | null, emit: boolean) {
        selected = selected === slug ? null : slug;
        paint();
        if (emit) syncMap();
      }

      function applyFilter(next: string | null) {
        nivel = next;
        filterBtns.forEach((b) => {
          b.setAttribute("aria-pressed", String((b.dataset.filter || null) === nivel));
        });
        document.querySelectorAll<HTMLElement>("#spots-list [data-row]").forEach((row) => {
          row.classList.toggle("hidden", nivel !== null && row.dataset.nivel !== nivel);
        });
        if (selected && nivel && nivelOf(selected) !== nivel) selected = null;
        paint();
        syncMap();
      }

      btns.forEach((btn) => {
        btn.addEventListener("click", () => choose(btn.dataset.spot ?? null, true));
      });

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => applyFilter(btn.dataset.filter || null));
      });

      window.addEventListener("message", (ev) => {
        const d = ev.data || {};
        if (d.source !== "surfcity-map") return;
        if (d.type === "ready") {
          syncMap();
          return;
        }
        if (d.type === "select") {
          selected = d.slug ?? null;
          paint();
        }
      });

      // El "ready" del iframe puede dispararse antes de que este script
      // esté escuchando: reintenta el envío hasta que el mapa confirme.
      mapEl?.addEventListener("load", syncMap);
      syncMap();
    </script>
  </main>

  <Footer />
</Layout>
