---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import Footer from "@/components/Footer.astro";
import PassBuilder from "@/components/comprar/PassBuilder";
---

<Layout title="Comprar pase">
  <!-- Guardia de sesión: comprar es parte de la plataforma -->
  <script>
    import { getUser } from "@/lib/session";
    if (!getUser()) {
      window.location.replace("/login?next=" + encodeURIComponent(location.pathname));
    }
  </script>

  <div class="flex min-h-screen flex-col bg-foam">
    <!-- Barra de checkout: Logo + stepper + ayuda -->
    <header class="sticky top-0 z-50 border-b border-divider bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-2 sm:px-6 sm:py-3.5 lg:px-10">
        <Logo href="/app" size={24} />
        <!-- Stepper: refleja el paso real del builder (evento "sc-paso").
             En móvil se compacta a tres círculos numerados sin rótulo (los
             rótulos quedan solo para lectores de pantalla). -->
        <div id="stepper" class="flex shrink-0 items-center gap-2 md:gap-3.5" aria-label="Progreso de la compra">
          <div class="flex items-center md:gap-2" data-paso="1">
            <span class="paso-dot flex size-7 items-center justify-center rounded-full pt-0.5 font-heading text-sm font-bold"></span>
            <span class="paso-label sr-only font-heading text-sm font-semibold md:not-sr-only">Arma tu pase</span>
          </div>
          <div class="h-0.5 w-5 bg-navy/20 md:w-9" data-linea="1"></div>
          <div class="flex items-center md:gap-2" data-paso="2">
            <span class="paso-dot flex size-7 items-center justify-center rounded-full pt-0.5 font-heading text-sm font-bold"></span>
            <span class="paso-label sr-only font-heading text-sm font-semibold md:not-sr-only">Pago</span>
          </div>
          <div class="h-0.5 w-5 bg-navy/20 md:w-9" data-linea="2"></div>
          <div class="flex items-center md:gap-2" data-paso="3">
            <span class="paso-dot flex size-7 items-center justify-center rounded-full pt-0.5 font-heading text-sm font-bold"></span>
            <span class="paso-label sr-only font-heading text-sm font-semibold md:not-sr-only">Listo</span>
          </div>
        </div>
        <a href="/cuenta" class="flex min-h-11 shrink-0 items-center px-1 text-sm text-muted-foreground hover:text-navy sm:px-2">Ayuda</a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-5 pb-14 pt-7 sm:px-6 sm:pt-11 lg:px-10">
      <PassBuilder client:load />
    </main>

    <Footer />
  </div>

  <script>
    // Pinta el stepper según el paso que emite el island (armar | pago | listo).
    const CHECK =
      '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M6 12.5l4 4 8-9" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
    const ORDEN = ["armar", "pago", "listo"];

    function pintarStepper(paso: string) {
      const idx = Math.max(0, ORDEN.indexOf(paso));
      document.querySelectorAll<HTMLElement>("#stepper [data-paso]").forEach((el) => {
        const i = Number(el.dataset.paso) - 1;
        const dot = el.querySelector<HTMLElement>(".paso-dot");
        const label = el.querySelector<HTMLElement>(".paso-label");
        if (!dot || !label) return;
        const base = "paso-dot flex size-7 items-center justify-center rounded-full pt-0.5 font-heading text-sm font-bold";
        const LABEL = "paso-label sr-only font-heading text-sm font-semibold md:not-sr-only";
        if (i < idx || (paso === "listo" && i === idx)) {
          dot.className = `${base} bg-success text-white`;
          dot.innerHTML = CHECK;
          label.className = `${LABEL} text-success`;
        } else if (i === idx) {
          dot.className = `${base} bg-navy text-white`;
          dot.textContent = String(i + 1);
          label.className = `${LABEL} font-bold text-navy`;
        } else {
          dot.className = `${base} bg-navy/10 text-muted-foreground`;
          dot.textContent = String(i + 1);
          label.className = `${LABEL} text-muted-foreground`;
        }
      });
      document.querySelectorAll<HTMLElement>("#stepper [data-linea]").forEach((el) => {
        const i = Number(el.dataset.linea);
        el.className = i <= idx ? "h-0.5 w-5 bg-success md:w-9" : "h-0.5 w-5 bg-navy/20 md:w-9";
      });
    }

    pintarStepper("armar");
    window.addEventListener("sc-paso", (ev) => {
      pintarStepper(String((ev as CustomEvent).detail));
    });
  </script>
</Layout>
